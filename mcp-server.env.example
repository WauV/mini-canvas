# 复制为 .local/mcp-server.env。不要复用 CouchDB 密码或 LiveSync 口令。
MINI_CANVAS_MCP_HOST=127.0.0.1
# 只填主机名，不填协议或端口；容器中额外加入 mcp-server。
MINI_CANVAS_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MINI_CANVAS_MCP_PORT=3220
MINI_CANVAS_MCP_DB=.local/mcp-server.sqlite
MINI_CANVAS_MCP_MASTER_KEY_BASE64=replace-with-32-random-bytes-as-base64
# expiresAt 可选，使用 Unix 秒时间戳；配置后令牌到期会被拒绝，轮换时可暂时并列两个身份记录。
MINI_CANVAS_MCP_AUTH_JSON=[{"token":"replace-with-at-least-32-random-characters","userId":"local-user","scopes":["notes:read","vault:list","attachments:read","drafts:write","drafts:commit","search:read","search:refresh"],"allowedPaths":[""],"expiresAt":1893456000}]
MINI_CANVAS_BRIDGE_URL=http://127.0.0.1:3210
MINI_CANVAS_BRIDGE_TOKEN=replace-with-the-token-from-livesync-bridge-env
MINI_CANVAS_MCP_AUTO_INDEX=true
MINI_CANVAS_VAULT_CASE_INSENSITIVE=true
# 已过期草稿继续加密保留的天数，之后由 MCP Server 自动删除。
MINI_CANVAS_MCP_DRAFT_RETENTION_DAYS=30
